# Copie este arquivo para .env e preencha.

# Porta do servidor
PORT=3001

# Endereço público do site (sem barra no fim). Usado no aviso de pagamento do Mercado Pago.
SITE_URL=https://www.suamarca.com.br

# Acesso inicial ao painel (/admin). Criado só na primeira vez que o servidor sobe.
# Depois, troque a senha pelo próprio painel.
ADMIN_EMAIL=admin@mysla.com.br
ADMIN_PASSWORD=troque-esta-senha

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE para testar e as de PRODUÇÃO para vender de verdade.
# Sem essas chaves, a loja roda em MODO DEMONSTRAÇÃO (pagamentos simulados).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# "Assinatura secreta" das notificações (Webhooks), opcional mas recomendado
MP_WEBHOOK_SECRET=
